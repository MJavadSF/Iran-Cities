{
  "name": "@code-plate/iran-cities",
  "version": "1.2.0",
  "description": "لیست کامل استان‌ها و شهرهای ایران (فارسی/انگلیسی) به‌همراه ابزارهای جستجو - بدون وابستگی، سازگار با هر فریمورک جاوااسکریپتی (React, Next.js, Vue, Angular, Node.js/Express و ...)",
  "keywords": [
    "iran",
    "province",
    "city",
    "استان",
    "شهر",
    "ایران",
    "فارسی",
    "پارسی",
    "شهرها و استان‌های ایران",
    "iran cities",
    "iran locations",
    "persian",
    "farsi",
    "location",
    "cities-list"
  ],
  "author": "code-plate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MJavadSF/Iran-Cities.git"
  },
  "homepage": "https://github.com/MJavadSF/Iran-Cities#readme",
  "bugs": {
    "url": "https://github.com/MJavadSF/Iran-Cities/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-data.mjs",
    "test": "npm run validate && npm run typecheck",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=14"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
